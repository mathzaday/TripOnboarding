<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:TripOnboarding.ViewModels"
    xmlns:models="clr-namespace:TripOnboarding.Models"
    x:Class="TripOnboarding.Views.TripOnboardingView"
    x:DataType="viewmodels:TripOnboardingViewModel"
    BackgroundColor="White"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto,Auto" Padding="5,10">

        <CarouselView
            Grid.Row="0"
            Position="{Binding Position}"
            Loop="False"
            ItemsSource="{Binding Items}">

            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:TripOnboardingItems">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="20">
                        <Label
                            Text="{Binding Titulo}"
                            FontSize="32"
                            TextColor="Black"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            HorizontalOptions="Center" />
                        <Label
                            Text="{Binding Descricao}"
                            FontSize="16"
                            TextColor="Black"
                            HorizontalTextAlignment="Center"
                            HorizontalOptions="Center"
                            Margin="20,0" />
                        <Image
                            Source="{Binding ImageURL}"
                            Aspect="AspectFit"
                            HeightRequest="300"
                            WidthRequest="300"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView
            x:Name="Indicador"
            Grid.Row="1"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Margin="0,10"
            IndicatorColor="#CCCCCC"
            SelectedIndicatorColor="#FF1568"
            IndicatorSize="14" />

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*"
            ColumnSpacing="15">

            <Button
                Grid.Column="0"
                Text="Get Started"
                BackgroundColor="#FF1568"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="50" />

            <Button
                Grid.Column="1"
                Command="{Binding NextPageCommand}"
                Text="Next"
                IsVisible="{Binding ShowButton}"
                BackgroundColor="#4EA717"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="50" />
        </Grid>
    </Grid>
</ContentPage>